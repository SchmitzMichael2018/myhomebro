{
  "name": "MyHomeBro",
  "short_name": "MyHomeBro",
  "description": "Contractor operations, Capture, agreements, and project workflows.",
  "start_url": "/app/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#07182f",
  "theme_color": "#07182f",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/static/favicon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/favicon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture what happened",
      "short_name": "Capture",
      "url": "/app/capture?source=pwa-shortcut",
      "icons": [{"src": "/static/favicon-192x192.png", "sizes": "192x192"}]
    },
    {
      "name": "Capture Inbox",
      "short_name": "Inbox",
      "url": "/app/capture?source=pwa-shortcut",
      "icons": [{"src": "/static/favicon-192x192.png", "sizes": "192x192"}]
    }
  ]
}
