VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional for local payment testing. Leave unset if you only need auth/pages.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional public product-tour media. A role-specific video stays in the
# "in preparation" state until both VIDEO_URL and CAPTIONS_URL are configured.
# VITE_PRODUCT_TOUR_CONTRACTOR_VIDEO_URL=https://cdn.example.com/contractor-tour.mp4
# VITE_PRODUCT_TOUR_CONTRACTOR_POSTER_URL=https://cdn.example.com/contractor-tour.jpg
# VITE_PRODUCT_TOUR_CONTRACTOR_CAPTIONS_URL=https://cdn.example.com/contractor-tour.vtt
# VITE_PRODUCT_TOUR_CONTRACTOR_TRANSCRIPT_URL=https://www.example.com/transcripts/contractor-tour
# VITE_PRODUCT_TOUR_HOMEOWNER_VIDEO_URL=https://cdn.example.com/homeowner-tour.mp4
# VITE_PRODUCT_TOUR_HOMEOWNER_POSTER_URL=https://cdn.example.com/homeowner-tour.jpg
# VITE_PRODUCT_TOUR_HOMEOWNER_CAPTIONS_URL=https://cdn.example.com/homeowner-tour.vtt
# VITE_PRODUCT_TOUR_HOMEOWNER_TRANSCRIPT_URL=https://www.example.com/transcripts/homeowner-tour
# VITE_PRODUCT_TOUR_PROPERTY_MANAGER_VIDEO_URL=https://cdn.example.com/property-manager-tour.mp4
# VITE_PRODUCT_TOUR_PROPERTY_MANAGER_POSTER_URL=https://cdn.example.com/property-manager-tour.jpg
# VITE_PRODUCT_TOUR_PROPERTY_MANAGER_CAPTIONS_URL=https://cdn.example.com/property-manager-tour.vtt
# VITE_PRODUCT_TOUR_PROPERTY_MANAGER_TRANSCRIPT_URL=https://www.example.com/transcripts/property-manager-tour
